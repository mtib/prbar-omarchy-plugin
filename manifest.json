{
  "schemaVersion": 1,
  "id": "mtib.prbar",
  "name": "prbar",
  "version": "0.1.0",
  "author": "mtib",
  "license": "MIT",
  "description": "GitHub pull requests waiting on your review, in the Omarchy bar: Direct / Team / Drafts tabs, reviews-done history, one notification per new request.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "Panel.qml" },
  "barWidget": {
    "displayName": "prbar",
    "description": "PRs blocked on your review, split into Direct, Team and Drafts.",
    "category": "Info",
    "aliases": ["github", "pull requests", "reviews"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": { "refreshIntervalSec": 60, "sortBy": "Recent activity" },
    "schema": [
      { "key": "refreshIntervalSec", "type": "integer", "label": "Refresh interval (seconds)",
        "min": 60, "max": 3600, "step": 60, "defaultValue": 60 },
      { "key": "sortBy", "type": "enum", "label": "Sort by",
        "options": ["Recent activity", "Least recent activity", "Newest PR", "Oldest PR"],
        "defaultValue": "Recent activity" }
    ]
  }
}
